{
  "auto_cover": true,                    // 自动更换封面
  "enable_anti_collision": true,         // 撞车监控
  "interval": 30,                        // 检测直播间隔(秒)
  "enable_youtube_monitor": true,        // 启用YouTube监控转播
  "enable_twitch_monitor": true,         // 启用Twitch监控转播
  
  // ===== Bilibili 直播配置 =====
  "bililive": {
    "enable_danmaku_command": true,      // 启用弹幕命令控制
    "room": 370627,                      // 直播间号
    "bili_rtmp_url": "rtmp://live-push.bilivideo.com/live-bvc/",  // B站RTMP服务器地址
    "bili_rtmp_key": ""                  // B站串流密钥 (需加双引号，因为以?开头)
  },
  
  // ===== Twitch 配置 =====
  "twitch": {
    "enable_monitor": true,              // 启用Twitch监控转播
    "channel_name": "",                  // 频道名称 (将出现于转播标题)
    "area_v2": 235,                      // B站分区ID (https://api.live.bilibili.com/room/v1/Area/getList)
    "channel_id": "",                    // Twitch频道ID (https://www.twitch.tv/ 后面的字符串)
    "proxy_region": "asl",               // 代理区域: na, eu, eu2, eu3, eu4, eu5, as, sa, eul, eu2l, asl, all, perf
    "quality": "best",                   // 画质选择
    "ffmpeg_cache": {
      "enabled": false,                  // 启用本地 HLS 缓存延迟推流
      "latency_secs": 8                  // 输入到输出的缓存延迟(秒)
    }
  },
  
  // ===== YouTube 配置 =====
  "youtube": {
    "enable_monitor": true,              // 启用YouTube监控转播
    "channel_name": "",                  // 频道名称 (将出现于转播标题)
    "channel_id": "",                    // YouTube频道ID
    "area_v2": 235,                      // B站分区ID (https://api.live.bilibili.com/room/v1/Area/getList)
    "quality": "best",                   // 画质选择
    "ffmpeg_cache": {
      "enabled": false,                  // 启用本地 HLS 缓存延迟推流
      "latency_secs": 8                  // 输入到输出的缓存延迟(秒)
    }
  },
  
  // ===== Niconico 配置 =====
  "niconico": {
    "enable_monitor": false,             // 启用 Niconico 监控转播
    "channel_name": "",                  // B站标题【转播】{channel_name}；有 niconico_name 时以 channels.json 为准
    "channel_id": "",                    // 频道 slug，WebUI 从 channels.json 选择
    "live_id": "",                       // 仅当未填 channel_id 时固定某一场 lv
    "area_v2": 235,                      // B站分区ID
    "quality": "best",                   // streamlink 画质: best, 1080p60, 720p60, 450p, 288p
    "cookies_file": "niconico_cookies.txt", // Netscape cookies，需包含 user_session
    "proxy": "http://127.0.0.1:7890",    // streamlink HTTP 代理；留空则直连
    "ffmpeg_cache": {
      "enabled": true,                   // 启用本地 HLS 缓存延迟推流
      "latency_secs": 12                 // Niconico 源约 3s 分片，建议 8–12 秒
    }
  },
  
  // ===== 其他配置 =====
  "proxy": null,                         // 代理地址 (无需代理可留空)
  "holodex_api_key": null,               // Holodex API密钥 (https://holodex.net/login)
  "holodex_jwt": null,                   // Holodex 登录 JWT (收藏夹 + Twitch 外部直播)
  "holodex_jwt_refreshed_at": null,      // 上次 Holodex JWT 续期时间 (Unix 秒，自动写入)
  "holodex_username": null,              // Holodex 用户名 (续期时自动写入)
  "holodex_skip_jwt_verify": false,    // 跳过 JWT 过期校验与自动续期
  "holodex_monitor_gate": true,        // false = yt-dlp 兜底：每次监控都直接用 yt-dlp；true 则按 Holodex / YouTube API 索引判断，每 5 分钟 yt-dlp 安全探测
  "youtube_api_key": null,               // YouTube Data API 密钥 (可选)，用 videos.list 校正 Holodex 的直播/预定状态；多个 key 用换行或逗号分隔，每个每天用 8,000 单位
  "riot_api_key": null,                  // Riot API密钥 (https://developer.riotgames.com/)
  "enable_lol_monitor": false,           // 启用LOL监控
  "lol_monitor_interval": 1,             // LOL监控间隔(秒)
  
  // ===== 撞车监控列表 =====
  "anti_collision_list": {
    // "主播名1": 房间号1,                // 主播名仅用于弹幕提醒
    // "主播名2": 房间号2,                // 房间号用于检测撞车
    // 可添加更多需要监控的直播间...
  },

  // ===== 优先频道配置 =====
  "priority_channel": {
    "enabled": true,                     // 启用优先频道监控
    "channel_name": "Kamito",            // 优先频道名称 (来自 channels.json)
    "youtube_channel_id": "UCgYCMluaLpERsyNXlPOvBtA",  // YouTube频道ID (自动从channels.json获取)
    "twitch_channel_id": "kamito_jp",    // Twitch频道ID (自动从channels.json获取)
    "default_area": 235,                   // 优先频道的默认分区ID
    "auto_restart": false                  // 优先频道下播后自动重启主频道监控
  },

  // ===== 多服务器集群配置 =====
  "cluster": {
    "enabled": false,                      // 启用后仅活跃节点会推送 RTMP
    "node_id": "server-a",                 // 每台服务器唯一 ID
    "node_name": "Server A",               // WebUI 显示名称
    "public_api_url": "http://server-a:3150", // 其他节点访问本节点 WebUI API 的地址
    "priority": 0,                         // 数值越高越优先成为活跃节点
    "heartbeat_interval_secs": 5,
    "failover_timeout_secs": 15,
    "lease_ttl_secs": 20,
    "sync_monitored_channels": true,        // 同步监控频道/优先频道/channels.json/areas.json
    "auto_failover": true,                 // 按优先级自动故障转移；false 时仅手动切换
    "peers": [
      {
        "node_id": "server-b",
        "name": "Server B",
        "api_url": "http://server-b:3150",
        "priority": 0
      }
    ],
    "thresholds": {
      "max_failed_restarts": 3,
      "max_external_api_failures": 3,
      "external_api_failure_window_secs": 60
    }
  }
}
